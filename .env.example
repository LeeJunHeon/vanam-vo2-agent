# =====================================================================
# vo2-agent 환경 변수 템플릿
# 실제 사용 시 이 파일을 .env로 복사 후 값 채우기
# .env는 .gitignore에 있어 git에 올라가지 않음
# =====================================================================

# DB 연결 정보 (Docker network 내부에서는 컨테이너명 사용)
POSTGRES_HOST=inventory-web-postgres
POSTGRES_PORT=5432
POSTGRES_DB=inventory

# vo2 schema 전용 user 비밀번호
VO2_ADMIN_PASSWORD=replace_me
VO2_WRITER_PASSWORD=replace_me
VO2_READER_PASSWORD=replace_me

# SQLAlchemy 연결 문자열
DATABASE_URL_WRITER=postgresql+psycopg://vo2_writer:replace_me@inventory-web-postgres:5432/inventory
DATABASE_URL_READER=postgresql+psycopg://vo2_reader:replace_me@inventory-web-postgres:5432/inventory
DATABASE_URL_ADMIN=postgresql+psycopg://vo2_admin:replace_me@inventory-web-postgres:5432/inventory

# MCP server 인증 토큰 (32자 이상 랜덤 hex)
INTERNAL_API_TOKEN=replace_me_min_32_chars_random_hex

# 로그 / CORS / Phase
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://vanam.synology.me
PHASE=1

# ETL 동작 파라미터
ETL_GRACE_SECONDS=60
ETL_INTERVAL_SECONDS=300
ETL_STATE_DIR=/app/state

# 시간대
TZ=Asia/Seoul
